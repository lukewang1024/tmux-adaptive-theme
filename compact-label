#!/bin/sh
set -eu

value=${1-}
limit=${2-12}
style=${3-middle}

case $limit in
   ''|*[!0-9]*) limit=12 ;;
esac

awk -v value="$value" -v limit="$limit" -v style="$style" 'BEGIN {
   if (length(value) <= limit) {
      print value
      exit
   }
   if (limit <= 3) {
      print substr(value, 1, limit)
      exit
   }
   if (style == "prefix") {
      print substr(value, 1, limit - 1) "…"
      exit
   }
   left = int(limit / 2)
   right = limit - 1 - left
   print substr(value, 1, left) "…" substr(value, length(value) - right + 1)
}'
